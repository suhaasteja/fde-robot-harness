#!/usr/bin/env bash
#
# demo — reset and drive the Physical SOC demo end to end.
#
#   bin/demo reset     restore the vulnerable fixture and clear run state
#   bin/demo reset --hard   also forget the onboarding interview
#   bin/demo check     is every service up and is the robot real?
#   bin/demo scan      run one CVE scan (robot narrates, ~4 min)
#   bin/demo gate      poll the approval gate until it opens, then watch
#   bin/demo amend     push after review, so the gate re-locks (fail-closed proof)
#   bin/demo status    one-line summary of where the incident is
#
# The fixture is one-shot: once the pipeline patches it, later scans correctly
# return VERDICT: NONE. Always `reset` before a rehearsal.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1
VENV="${REACHY_VENV:-$HOME/reachy-conv}"
PY="$VENV/bin/python"
# The known-good vulnerable fixture lives as a directory, not a git ref: the
# pipeline merges remediation PRs into main, so "restore from HEAD" would
# eventually stop restoring the vulnerability. This is never patched.
BASELINE="$ROOT/demo-fixture-baseline"
FIXTURE="$ROOT/demo-fixture"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
ok()   { printf '%s✓%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s!%s %s\n' "$c_yel" "$c_off" "$*"; }
err()  { printf '%s✗%s %s\n' "$c_red" "$c_off" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }

session_id() {
  "$PY" -c "import json;print(json.load(open('.run/cve-monitor.json')).get('session_id',''))" 2>/dev/null
}
incident_pr() {
  "$PY" -c "
import json
inc=list((json.load(open('.run/cve-monitor.json')).get('incidents') or {}).values())
print((inc[0].get('pr_url','') if inc else '').rsplit('/',1)[-1])" 2>/dev/null
}

cmd_reset() {
  [ -d "$BASELINE" ] || { err "Missing baseline at $BASELINE"; exit 1; }

  # Replace the whole tree, not one file. The fixture grew from 3 files to a
  # nine-file service, and the agent can patch any of them -- restoring only
  # middleware.js left whatever it changed in lib/ or routes/ in place.
  rm -rf "$FIXTURE"
  cp -R "$BASELINE" "$FIXTURE"
  rm -f "$FIXTURE/README.md"

  rm -f "$ROOT/.run/cve-monitor.json" "$ROOT/.run/incident.json" \
        "$ROOT/.run/reachy-approval.json"

  if [ "${1:-}" = "--hard" ]; then
    rm -f "$ROOT/state/customer_profile.json"
    ok "fixture restored, run state AND customer profile cleared"
    dim "  you will need to re-run the onboarding interview"
  else
    ok "fixture restored to vulnerable, run state cleared"
    local approver
    approver=$("$PY" -c "
import json,pathlib
try: print(json.loads(pathlib.Path('$ROOT/state/customer_profile.json').read_text()).get('approver',''))
except Exception: print('')" 2>/dev/null)
    [ -n "$approver" ] && dim "  profile kept — approver: $approver (use --hard to clear)"
  fi

  local n; n=$(find "$FIXTURE" -type f | wc -l | tr -d ' ')
  dim "  $n files restored"
  ( cd "$FIXTURE" && node --test 2>&1 | grep -E "^# (pass|fail)" | sed 's/^/  /' )
  dim "  (1 failing security test is correct — that failure IS the vulnerability)"
}

cmd_check() {
  local bad=0
  # Probe with curl against `localhost`, not `nc` against the IPv4 literal:
  # TrueForge binds IPv6-only ([::1]:8790), so `nc -z 127.0.0.1 8790` reports it
  # down while it is serving perfectly.
  for pair in "8000:daemon" "7860:conversation app" "8790:TrueForge" "7880:robot-mcp" "7881:codebase-mcp"; do
    local port="${pair%%:*}" name="${pair##*:}"
    if curl -s -m 4 -o /dev/null "http://localhost:$port/" 2>/dev/null; then ok "$name (:$port)"
    else err "$name (:$port) DOWN"; bad=1; fi
  done

  # A simulated daemon speaks and reports fine but never moves. That difference
  # is invisible until the robot is on camera, so surface it here.
  if curl -s -m 4 "http://127.0.0.1:8000/api/state/present_head_pose" >/dev/null 2>&1; then
    if ls /dev/cu.usbmodem* >/dev/null 2>&1; then ok "robot serial device present"
    else warn "no serial device — daemon may be running --mockup-sim (no motion)"; fi
  fi

  # The single most common silent failure: /say missing means every announcement
  # falls back to the laptop's voice while still reporting success.
  if curl -s -m 4 "http://127.0.0.1:7860/openapi.json" 2>/dev/null | grep -q '"/say"'; then
    ok "/say route present (robot voice)"
  else
    err "/say MISSING — announcements will come from the Mac. Run bin/patch-app, restart the app."
    bad=1
  fi

  local muted; muted=$(curl -s -m 4 http://127.0.0.1:7860/mic 2>/dev/null)
  case "$muted" in *true*) warn "microphone is MUTED — the robot cannot hear your approval";; *) ok "microphone live";; esac

  [ "$bad" -eq 0 ] && ok "ready" || err "fix the above before demoing"
}

cmd_scan() {
  dim "Scanning… the robot narrates as it works. Takes a few minutes."
  "$PY" bin/cve-monitor --once
  cmd_status
}

cmd_status() {
  local sid pr
  sid=$(session_id); pr=$(incident_pr)
  [ -n "$sid" ] && dim "  session : http://localhost:8790/sessions/$sid"
  [ -n "$pr" ]  && dim "  PR      : #$pr"
  "$PY" - <<'EOF' 2>/dev/null || echo "  no run state yet — bin/demo scan"
import json
try: s=json.load(open('.run/incident.json'))
except Exception: raise SystemExit(1)
a=s.get('approval') or {}
pre=a.get('prerequisites') or {}
if pre:
    for k,v in pre.items(): print(f"  {'PASS' if v else 'WAIT'}  {k}")
print("  approval:", a.get('status'), "| merge:", (s.get('merge') or {}).get('status'))
if a.get('last_words'): print("  heard  :", repr(a['last_words'])[:70])
EOF
}

cmd_amend() {
  # Push a trivial commit to the open remediation branch AFTER Qodo has reviewed.
  # The head SHA moves, Qodo's review is now bound to an older commit, and
  # qodo_followup goes false through the REAL enforce_gate() -- nothing here is
  # special-cased. This is the attack the gate exists to stop: get a clean
  # review, then change the code.
  local pr branch
  pr=$(incident_pr)
  [ -z "$pr" ] && { err "No incident yet. Run: bin/demo scan"; exit 1; }
  branch=$(gh pr view "$pr" --json headRefName --jq .headRefName 2>/dev/null)
  [ -z "$branch" ] && { err "Could not read the PR branch for #$pr"; exit 1; }

  # Read the ref directly: `gh pr view --json headRefOid` serves a cached value
  # and lags a push by long enough to look like the amend silently failed.
  git fetch -q origin "$branch" 2>/dev/null
  local before; before=$(git ls-remote origin "refs/heads/$branch" | cut -f1)
  dim "  branch      : $branch"
  dim "  head before : ${before:0:7}"

  local wt; wt=$(mktemp -d "$ROOT/.run/amend-XXXX")
  git fetch -q origin "$branch" 2>/dev/null
  if ! git worktree add -q --detach "$wt" "origin/$branch" 2>/dev/null; then
    err "Could not check out $branch"; rm -rf "$wt"; exit 1
  fi
  {
    printf '\n// touched after review — the gate must notice\n' >> "$wt/demo-fixture/middleware.js"
    git -C "$wt" add demo-fixture/middleware.js
    git -C "$wt" -c user.email=demo@local -c user.name="Physical SOC demo" \
      commit -q -m "Touch after review (demo: prove the gate re-locks)"
    git -C "$wt" push -q origin "HEAD:$branch"
  } || { err "Amend failed"; git worktree remove --force "$wt" 2>/dev/null; exit 1; }
  git worktree remove --force "$wt" 2>/dev/null

  local after; after=$(git ls-remote origin "refs/heads/$branch" | cut -f1)
  ok "head moved: ${before:0:7} -> ${after:0:7}"
  dim "  Qodo's review is now bound to the OLD commit."
  dim "  Run bin/demo gate — qodo_followup should go false and the robot should say so."
}

cmd_gate() {
  local sid pr; sid=$(session_id); pr=$(incident_pr)
  if [ -z "$sid" ] || [ -z "$pr" ]; then
    err "No incident yet. Run: bin/demo scan"; exit 1
  fi
  dim "Polling the gate. Qodo takes a few minutes; approval stays locked until it lands."
  dim "When it says waiting, say out loud: I approve commit <sha>"
  "$PY" bin/soc-watch --session "$sid" --pr "$pr"
}

case "${1:-}" in
  reset)  shift; cmd_reset "$@" ;;
  check)  cmd_check ;;
  scan)   cmd_scan ;;
  gate)   cmd_gate ;;
  amend)  cmd_amend ;;
  status) cmd_status ;;
  *) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
