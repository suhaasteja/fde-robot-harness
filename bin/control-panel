#!/usr/bin/env python3
"""
control-panel — one web UI for the Reachy Mini conversation app.

The pieces you want live in three different places, so this stitches them
together rather than patching the pinned app package:

  volume / mic     -> daemon HTTP API on :8000  (always available)
  system prompt    -> the app's own API on :7860 (only when started with --ui)
  transcript       -> parsed out of logs/app.log
  saved memory     -> ~/.local/share/reachy_mini_conversation_app/memory.v1.json

Stdlib only, so it runs under any python3 without touching the venv.

    bin/control-panel            # serve on http://127.0.0.1:7870
    bin/control-panel --port N
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

DAEMON = "http://127.0.0.1:8000"
APP_UI = "http://127.0.0.1:7860"

# The app's "no custom profile" sentinel is a literal display string, not "Default".
DEFAULT_PERSONALITY = "(built-in default)"

# The app's route prefix moved between releases: v0.8.0 (Gradio UI) serves them
# at the root, v0.10.0 under /api/v1. Probe rather than hardcode, so the panel
# works across the versions we actually switch between. The daemon is separate
# and always /api.
_APP_PREFIX: str | None = None


def app_prefix() -> str | None:
    """Return the app's API prefix, probing once and caching the result."""
    global _APP_PREFIX
    if _APP_PREFIX is not None:
        return _APP_PREFIX or None
    for candidate in ("/api/v1", ""):
        ok, _ = fetch(f"{APP_UI}{candidate}/personalities", timeout=1.5)
        if ok:
            _APP_PREFIX = candidate
            return candidate
    return None


def reset_app_prefix() -> None:
    """Forget the cached prefix, so a restarted app on a different version re-probes."""
    global _APP_PREFIX
    _APP_PREFIX = None

REPO_ROOT = Path(__file__).resolve().parent.parent
LOG_FILE = REPO_ROOT / "logs" / "app.log"
MEMORY_FILE = Path.home() / ".local/share/reachy_mini_conversation_app/memory.v1.json"

# 2026-08-29 10:30:33,245 INFO ...console:885 | role=assistant content=Hi there
LOG_RE = re.compile(
    r"^(?P<ts>\d{4}-\d\d-\d\d \d\d:\d\d:\d\d),\d+ .*?\| role=(?P<role>\S+) content=(?P<content>.*)$"
)


# --- upstream helpers ------------------------------------------------------


def fetch(url: str, method: str = "GET", payload: dict | None = None, timeout: float = 6.0):
    """Call an upstream JSON API. Returns (ok, data)."""
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode()
            return True, (json.loads(body) if body else {})
    except urllib.error.HTTPError as e:
        try:
            return False, json.loads(e.read().decode())
        except Exception:
            return False, {"error": f"HTTP {e.code}"}
    except Exception as e:
        return False, {"error": str(e)}


def read_transcript(limit: int = 200):
    """Parse the app log into conversation turns.

    The realtime backend emits user speech as a stream of `user_partial` lines,
    each holding one fragment. Consecutive fragments are joined back into a
    single utterance so the panel shows sentences, not word salad.
    """
    if not LOG_FILE.exists():
        return []

    turns: list[dict] = []
    try:
        lines = LOG_FILE.read_text(errors="replace").splitlines()
    except Exception:
        return []

    for line in lines:
        m = LOG_RE.match(line)
        if not m:
            continue
        role = m.group("role")
        content = m.group("content")
        ts = m.group("ts")
        speaker = "user" if role.startswith("user") else "assistant"
        partial = role.endswith("_partial")

        # Each utterance is logged twice: first as a run of `*_partial` lines
        # carrying incremental fragments, then once as a final non-partial line
        # holding the recognizer's cleaned-up full text (punctuation fixed, words
        # revised). The final line is authoritative, so it replaces the
        # accumulated fragments instead of adding a second turn.
        open_partial = bool(turns) and turns[-1]["role"] == speaker and turns[-1]["partial"]

        if open_partial and partial:
            turns[-1]["content"] += content
            turns[-1]["ts"] = ts
        elif open_partial and not partial:
            turns[-1]["content"] = content
            turns[-1]["partial"] = False
            turns[-1]["ts"] = ts
        else:
            turns.append({"role": speaker, "content": content, "ts": ts, "partial": partial})

    for t in turns:
        t["content"] = " ".join(t["content"].split())
    turns = [t for t in turns if t["content"]]
    return turns[-limit:]


def read_memory():
    if not MEMORY_FILE.exists():
        return []
    try:
        return json.loads(MEMORY_FILE.read_text()).get("facts", [])
    except Exception:
        return []


def clear_memory():
    """Empty the saved-facts store, backing it up first."""
    if not MEMORY_FILE.exists():
        return {"ok": True, "cleared": 0}
    try:
        data = json.loads(MEMORY_FILE.read_text())
        n = len(data.get("facts", []))
        MEMORY_FILE.with_suffix(".json.bak").write_text(json.dumps(data, indent=2))
        data["facts"] = []
        MEMORY_FILE.write_text(json.dumps(data, indent=2))
        return {"ok": True, "cleared": n}
    except Exception as e:
        return {"ok": False, "error": str(e)}


def app_ui_up() -> bool:
    return app_prefix() is not None


# --- request handling ------------------------------------------------------


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):  # quiet
        pass

    def _send(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _html(self):
        body = PAGE.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = self.path.split("?")[0]

        if p == "/":
            return self._html()

        if p == "/api/state":
            ok_v, vol = fetch(f"{DAEMON}/api/volume/current")
            ok_m, mic = fetch(f"{DAEMON}/api/volume/microphone/current")
            ui = app_ui_up()
            state = {
                "daemon": ok_v,
                "app_ui": ui,
                "volume": vol.get("volume") if ok_v else None,
                "mic": mic.get("volume") if ok_m else None,
                "device": vol.get("device") if ok_v else None,
                "memory": read_memory(),
            }
            if ui:
                pfx = app_prefix() or ""
                ok_p, pers = fetch(f"{APP_UI}{pfx}/personalities")
                if ok_p:
                    state["personalities"] = pers.get("choices", [])
                    state["current_personality"] = pers.get("current")
                    state["locked"] = pers.get("locked", False)
                ok_vc, cur = fetch(f"{APP_UI}{pfx}/voices/current")
                if ok_vc:
                    state["voice"] = cur.get("voice") if isinstance(cur, dict) else cur
                ok_mu, mu = fetch(f"{APP_UI}{pfx}/mic")
                if ok_mu:
                    state["muted"] = mu.get("muted", False)
            return self._send(state)

        if p == "/api/transcript":
            return self._send({"turns": read_transcript()})

        if p == "/api/prompt":
            name = DEFAULT_PERSONALITY
            if "?" in self.path:
                from urllib.parse import parse_qs, urlparse

                name = parse_qs(urlparse(self.path).query).get("name", [DEFAULT_PERSONALITY])[0]
            pfx = app_prefix() or ""
            ok, data = fetch(f"{APP_UI}{pfx}/personalities/load?name={urllib.request.quote(name)}")
            return self._send(data if ok else {"error": data.get("error", "app UI unavailable")},
                              200 if ok else 502)

        if p == "/api/voices":
            pfx = app_prefix() or ""
            ok, data = fetch(f"{APP_UI}{pfx}/voices")
            return self._send({"voices": data if ok else []})

        return self._send({"error": "not found"}, 404)

    def do_POST(self):
        p = self.path.split("?")[0]
        n = int(self.headers.get("Content-Length") or 0)
        try:
            payload = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            payload = {}

        if p == "/api/volume":
            ok, data = fetch(f"{DAEMON}/api/volume/set", "POST", {"volume": int(payload.get("volume", 50))})
            return self._send(data, 200 if ok else 502)

        if p == "/api/mic":
            ok, data = fetch(f"{DAEMON}/api/volume/microphone/set", "POST",
                             {"volume": int(payload.get("volume", 50))})
            return self._send(data, 200 if ok else 502)

        if p == "/api/mute":
            # App-level mute, distinct from the daemon's mic gain above.
            pfx = app_prefix() or ""
            ok, data = fetch(f"{APP_UI}{pfx}/mic", "POST", {"muted": bool(payload.get("muted"))})
            return self._send(data, 200 if ok else 502)

        if p == "/api/test-sound":
            ok, data = fetch(f"{DAEMON}/api/volume/test-sound", "POST", {})
            return self._send(data, 200 if ok else 502)

        if p == "/api/memory/clear":
            return self._send(clear_memory())

        if p == "/api/prompt":
            # Save under a user profile, then apply it live.
            name = payload.get("name") or "custom"
            save = {
                "name": name,
                "instructions": payload.get("instructions", ""),
                "greeting": payload.get("greeting"),
                "tools_text": payload.get("tools_text", ""),
                "voice": payload.get("voice"),
            }
            pfx = app_prefix() or ""
            ok, data = fetch(f"{APP_UI}{pfx}/personalities/save", "POST", save)
            if not ok or not data.get("ok"):
                return self._send({"ok": False, "error": data.get("error", "save failed")}, 502)
            ok2, applied = fetch(f"{APP_UI}{pfx}/personalities/apply", "POST",
                                 {"name": data.get("value"), "persist": True})
            return self._send({"ok": ok2, "value": data.get("value"), "applied": applied})

        return self._send({"error": "not found"}, 404)


PAGE = r"""<!doctype html>
