<script>
const $=s=>document.querySelector(s);
let toastT;
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');
  clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2200);}
const api=(u,o)=>fetch(u,o).then(r=>r.json());

function pill(el,ok,txt){el.className='pill '+(ok?'on':'off');el.textContent=txt;}

let dragging=false;
['vol','mic'].forEach(id=>{
  const el=$('#'+id);
  el.addEventListener('input',()=>{$('#'+id+'-v').textContent=el.value;dragging=true;});
  el.addEventListener('change',async()=>{
    await api('/api/'+(id==='vol'?'volume':'mic'),{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({volume:+el.value})});
    dragging=false;toast((id==='vol'?'Volume':'Mic')+' → '+el.value);
  });
});

$('#test').onclick=async()=>{await api('/api/test-sound',{method:'POST'});toast('Test sound sent');};

let muted=false;
$('#mute').onclick=async()=>{
  muted=!muted;
  await api('/api/mute',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({muted})});
  toast(muted?'Mic muted':'Mic live');refresh();
};

$('#clearmem').onclick=async()=>{
  const r=await api('/api/memory/clear',{method:'POST'});
  toast(r.ok?`Cleared ${r.cleared} fact(s)`:'Failed');refresh();
};

async function loadPrompt(){
  const name=$('#pers').value||'Default';
  const r=await api('/api/prompt?name='+encodeURIComponent(name));
  $('#instr').value=r.instructions||'';
}
$('#pers').onchange=loadPrompt;
$('#reload').onclick=()=>{loadPrompt();toast('Reloaded');};

$('#save').onclick=async()=>{
  const btn=$('#save');btn.disabled=true;btn.textContent='Saving…';
  const r=await api('/api/prompt',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({name:$('#pname').value||'custom',instructions:$('#instr').value})});
  btn.disabled=false;btn.textContent='Save & apply';
  toast(r.ok?'Applied live':'Failed: '+(r.error||'?'));
};

let lastLen=0;
async function refreshChat(){
  const {turns}=await api('/api/transcript');
  const c=$('#chat');
  if(!turns.length){c.innerHTML='<div class="empty">No transcript yet.</div>';return;}
  if(turns.length===lastLen)return;
  const atBottom=c.scrollHeight-c.scrollTop-c.clientHeight<60;
  lastLen=turns.length;
  c.innerHTML=turns.map(t=>`<div class="turn ${t.role}"><div class="who">${t.role} · ${t.ts.slice(11)}</div>${
    t.content.replace(/[&<>]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[ch]))}</div>`).join('');
  if(atBottom)c.scrollTop=c.scrollHeight;
}

let persLoaded=false;
async function refresh(){
  const s=await api('/api/state');
  pill($('#p-daemon'),s.daemon,s.daemon?'daemon up':'daemon down');
  pill($('#p-ui'),s.app_ui,s.app_ui?'app connected':'app UI off');
  $('#p-dev').textContent=s.device||'';
  $('#p-dev').className='pill';
  if(!dragging){
    if(s.volume!=null){$('#vol').value=s.volume;$('#vol-v').textContent=s.volume;}
    if(s.mic!=null){$('#mic').value=s.mic;$('#mic-v').textContent=s.mic;}
  }
  const f=$('#facts');
  f.innerHTML=(s.memory&&s.memory.length)
    ? s.memory.map(x=>`<div class="fact"><span>${x.text}</span></div>`).join('')
    : '<div class="empty">No saved facts.</div>';
  if(s.muted!=null){muted=s.muted;$('#mute').textContent=muted?'Unmute mic':'Mute mic';}
  $('#mute').disabled=!s.app_ui;
  $('#ui-warn').style.display=s.app_ui?'none':'block';
  ['pers','instr','pname','save','reload'].forEach(i=>$('#'+i).disabled=!s.app_ui);
  if(s.app_ui&&!persLoaded&&s.personalities){
    persLoaded=true;
    $('#pers').innerHTML=s.personalities.map(p=>`<option ${p===s.current_personality?'selected':''}>${p}</option>`).join('');
    loadPrompt();
  }
  if(!s.app_ui)persLoaded=false;
}
refresh();refreshChat();
setInterval(refresh,4000);
setInterval(refreshChat,3000);
</script></body></html>
"""


def main():
    ap = argparse.ArgumentParser(description="Reachy Mini control panel")
    ap.add_argument("--port", type=int, default=7870)
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"Control panel  →  http://{args.host}:{args.port}")
    print(f"  daemon  {DAEMON}   (volume)")
    print(f"  app UI  {APP_UI}   (system prompt — needs 'reachy-app start --ui')")
    print(f"  log     {LOG_FILE}")
    print("Ctrl-C to stop.")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
