<div id="toast"></div>
<script>
const $=s=>document.querySelector(s);
let toastT;
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');
  clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2200);}
const api=(u,o)=>fetch(u,o).then(r=>r.json());

function pill(el,ok,txt){el.className='pill '+(ok?'on':'off');el.textContent=txt;}

let dragging=false;
['vol','mic'].forEach(id=>{
  const el=$('#'+id);
  el.addEventListener('input',()=>{$('#'+id+'-v').textContent=el.value;dragging=true;});
  el.addEventListener('change',async()=>{
    await api('/api/'+(id==='vol'?'volume':'mic'),{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({volume:+el.value})});
    dragging=false;toast((id==='vol'?'Volume':'Mic')+' → '+el.value);
  });
});

$('#test').onclick=async()=>{await api('/api/test-sound',{method:'POST'});toast('Test sound sent');};

let muted=false;
$('#mute').onclick=async()=>{
  muted=!muted;
  await api('/api/mute',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({muted})});
  toast(muted?'Mic muted':'Mic live');refresh();
};

$('#clearmem').onclick=async()=>{
  const r=await api('/api/memory/clear',{method:'POST'});
  toast(r.ok?`Cleared ${r.cleared} fact(s)`:'Failed');refresh();
};

async function loadPrompt(){
  const name=$('#pers').value||'Default';
  const r=await api('/api/prompt?name='+encodeURIComponent(name));
  $('#instr').value=r.instructions||'';
}
$('#pers').onchange=loadPrompt;
$('#reload').onclick=()=>{loadPrompt();toast('Reloaded');};

$('#save').onclick=async()=>{
  const btn=$('#save');btn.disabled=true;btn.textContent='Saving…';
  const r=await api('/api/prompt',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({name:$('#pname').value||'custom',instructions:$('#instr').value})});
  btn.disabled=false;btn.textContent='Save & apply';
  toast(r.ok?'Applied live':'Failed: '+(r.error||'?'));
};

let lastLen=0;
async function refreshChat(){
  const {turns}=await api('/api/transcript');
  const c=$('#chat');
  if(!turns.length){c.innerHTML='<div class="empty">No transcript yet.</div>';return;}
  // Compare content, not just count: a partial turn grows in place, so a
  // length check alone would leave the last line stale mid-utterance.
  const sig=turns.length+'|'+(turns[turns.length-1]||{}).content;
  if(sig===lastLen)return;
  const atBottom=c.scrollHeight-c.scrollTop-c.clientHeight<60;
  lastLen=sig;
  c.innerHTML=turns.map(t=>`<div class="turn ${t.role}"><div class="who">${t.role} · ${t.ts.slice(11)}</div>${
    t.content.replace(/[&<>]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[ch]))}</div>`).join('');
  if(atBottom)c.scrollTop=c.scrollHeight;
}

let persLoaded=false;
async function refresh(){
  const s=await api('/api/state');
  pill($('#p-daemon'),s.daemon,s.daemon?'daemon up':'daemon down');
  pill($('#p-ui'),s.app_ui,s.app_ui?'app connected':'app UI off');
  $('#p-dev').textContent=s.device||'';
  $('#p-dev').className='pill';
  if(!dragging){
    if(s.volume!=null){$('#vol').value=s.volume;$('#vol-v').textContent=s.volume;}
    if(s.mic!=null){$('#mic').value=s.mic;$('#mic-v').textContent=s.mic;}
  }
  const f=$('#facts');
  f.innerHTML=(s.memory&&s.memory.length)
    ? s.memory.map(x=>`<div class="fact"><span>${x.text}</span></div>`).join('')
    : '<div class="empty">No saved facts.</div>';
  // A rotated or newly-created session swaps the iframe without a manual reload.
  if(s.trueforge_session!==tfSession||s.trueforge_url!==tfBase){
    tfSession=s.trueforge_session; tfBase=s.trueforge_url;
    $('#tab-tf').textContent = tfSession ? 'Agent ●' : 'Agent';
    if(curTab==='tf')syncAgentFrame();
  }
  if(s.muted!=null){muted=s.muted;$('#mute').textContent=muted?'Unmute mic':'Mute mic';}
  $('#mute').disabled=!s.app_ui;
  $('#ui-warn').style.display=s.app_ui?'none':'block';
  ['pers','instr','pname','save','reload'].forEach(i=>$('#'+i).disabled=!s.app_ui);
  if(s.app_ui&&!persLoaded&&s.personalities){
    persLoaded=true;
    $('#pers').innerHTML=s.personalities.map(p=>`<option ${p===s.current_personality?'selected':''}>${p}</option>`).join('');
    loadPrompt();
  }
  if(!s.app_ui)persLoaded=false;
}
// Live updates: the app pushes an activity marker the moment anything happens,
// so refresh on that rather than on a timer. The interval below is only a
// safety net for when the stream is down (app stopped, or started without --ui).
let es=null, esTimer=null;
function connectEvents(){
  if(es){es.close();es=null;}
  try{
    es=new EventSource('/api/events');
    es.addEventListener('activity',()=>{refreshChat();});
    es.addEventListener('ready',()=>{$('#p-live').className='pill on';
      $('#p-live').textContent='live';refreshChat();});
    es.onerror=()=>{
      $('#p-live').className='pill off';$('#p-live').textContent='polling';
      if(es){es.close();es=null;}
      clearTimeout(esTimer);esTimer=setTimeout(connectEvents,5000);
    };
  }catch(e){$('#p-live').className='pill off';$('#p-live').textContent='polling';}
}

let appLoaded=false;
let curTab='ctl';
function showTab(which){
  const app=which==='app';
  const incident=which==='incident';
  const tf=which==='tf';
  curTab=which;
  document.querySelector('main').style.display=(app||incident||tf)?'none':'grid';
  $('#incident').style.display=incident?'block':'none';
  $('#appframe').style.display=app?'block':'none';
  $('#tfwrap').style.display=tf?'block':'none';
  for(const [id,name] of [['tab-ctl','ctl'],['tab-incident','incident'],['tab-app','app'],['tab-tf','tf']])
    $('#'+id).className='ghost tab'+(which===name?' on':'');
  if(app&&!appLoaded){$('#appframe').src='http://127.0.0.1:7860/';appLoaded=true;}
  if(incident)refreshIncident();
  if(tf)syncAgentFrame();
}
$('#tab-ctl').onclick=()=>showTab('ctl');
$('#tab-app').onclick=()=>showTab('app');
$('#tab-incident').onclick=()=>showTab('incident');
$('#tab-tf').onclick=()=>showTab('tf');

const esc=s=>String(s==null?'—':s).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
function evidenceState(value,doneValues=[]){
  if(doneValues.includes(value))return 'done';
  if(['running','reviewing','pending_approval'].includes(value))return 'active';
  return 'locked';
}
async function refreshIncident(){
  const s=await api('/api/incident');
  $('#i-cve').textContent=s.cve||'Waiting for incident';
  $('#i-summary').textContent=s.summary||'No active security advisory';
  $('#i-service').textContent=s.service||'—';$('#i-source').textContent=s.source||'—';
  $('#i-fetched').textContent=s.fetched_at||'—';$('#i-sha').textContent=s.commit?`COMMIT ${s.commit}`:'NO COMMIT';
  const monitor=s.monitor||{};
  let monitorText=`EVERY ${Math.round((monitor.interval_seconds||60)/60)} MIN · ${(monitor.status||'starting').replaceAll('_',' ').toUpperCase()}`;
  if(monitor.next_check_at){const left=Math.max(0,Math.ceil((Date.parse(monitor.next_check_at)-Date.now())/1000));monitorText+=` · NEXT ${Math.floor(left/60)}:${String(left%60).padStart(2,'0')}`;}
  $('#i-monitor').textContent=monitorText;
  const findings=monitor.findings||[];
  $('#finding-count').textContent=`${findings.length} CVE${findings.length===1?'':'s'}`;
  $('#finding-list').innerHTML=findings.length?findings.map(f=>`<div class="finding-row"><span class="finding-cve">${esc(f.cve)}</span><span class="finding-status ${f.status==='applicable'?'applicable':''}">${esc(f.status)}</span><span class="finding-reason">${esc(f.reason)}</span></div>`).join(''):'<div class="empty">Waiting for first repository scan.</div>';
  const sev=(s.severity||'unknown').toUpperCase();$('#i-severity').textContent=sev;
  $('#i-severity').style.visibility=sev==='UNKNOWN'?'hidden':'visible';
  const tests=s.tests||{},q=s.qodo||{},approval=s.approval||{},merge=s.merge||{};
  const agents=s.subagents||[];
  const events=[
    ['MCP · Bright Data',s.fetched_at?'done':'locked',s.fetched_at?'source verified':'not started'],
    ['Sandbox · isolated',evidenceState(tests.status,['passed']),tests.status||'not started'],
    ['Subagents',agents.length>=2?'done':agents.length?'active':'locked',`${agents.length} returned`],
    ['Session preserved',s.session_id?'done':'locked',s.session_id?String(s.session_id).slice(0,10):'no session'],
    ['Qodo review',evidenceState(q.status,['passed','complete','approved']),q.status||'not started'],
    ['Human approval',evidenceState(approval.status,['approved']),approval.status||'locked']
  ];
  $('#engine-events').innerHTML=events.map(([name,state,detail])=>`<div class="engine-event ${state}"><span class="event-icon">${state==='done'?'✓':state==='active'?'•':'—'}</span><span class="event-name">${esc(name)}</span><span class="event-detail">${esc(detail)}</span></div>`).join('');
  const testDone=tests.status==='passed',qDone=['passed','complete','approved'].includes(q.status);
  const items=[
    ['Detected',s.fetched_at?'done':'locked',s.source||'Awaiting MCP evidence',''],
    ['Reproduced',tests.status!=='pending'?'done':'locked',tests.before||'Awaiting failing test',''],
    ['Patched',s.commit?'done':'locked',s.commit?`Commit ${s.commit}`:'No patch generated',''],
    ['Sandbox tests',testDone?'done':tests.status==='failed'?'failed':tests.status==='running'?'active':'locked',testDone?`${tests.passed}/${tests.total} passed`:tests.status||'Not started',tests.total?`<div class="progress"><span style="width:${Math.min(100,100*(tests.passed||0)/tests.total)}%"></span></div>`:''],
    ['Qodo review',qDone?'done':q.status==='reviewing'?'active':'locked',q.pr||'Awaiting code checks',q.finding?`<div class="review-box">${esc(q.finding)}${q.followup?' · follow-up complete':''}</div>`:''],
    ['Approval',approval.status==='approved'?'done':approval.status==='waiting'?'active':'locked',approval.status==='waiting'?`Waiting for ${approval.approver||'approver'}`:approval.status||'Locked','']
  ];
  $('#stages').innerHTML=items.map(([name,state,detail,extra],i)=>`<article class="stage ${state}"><span class="stage-num">0${i+1}</span><h4>${esc(name)}</h4><p>${esc(detail)}</p>${extra}</article>`).join('');
  const merged=merge.status==='merged',approved=approval.status==='approved';
  const lock=$('#merge-lock');lock.className='merge-lock'+(merged?' approved':'');
  lock.innerHTML=merged?`<span>✓ MERGED · ${esc(s.commit)}</span><small>Approved evidence recorded</small>`:
    approved?`<span>🔓 APPROVED TO MERGE</span><small>Exact commit ${esc(s.commit)}</small>`:
    '<span>🔒 MERGE LOCKED</span><small>Waiting for verified work and human approval</small>';
}

// Point the iframe straight at the live thread. TrueForge's own session VIEW
// streams fine once open — it is only the sidebar that needs a page reload to
// notice a new session. Following the id here removes that entirely.
let tfSession=null, tfBase=null;
function syncAgentFrame(){
  const f=$('#tfframe');
  if(!tfSession){ f.style.display='none'; $('#tfnone').style.display='block'; return; }
  $('#tfnone').style.display='none'; f.style.display='block';
  const want=(tfBase||'http://localhost:8790')+'/sessions/'+tfSession;
  if(f.getAttribute('data-url')!==want){ f.setAttribute('data-url',want); f.src=want; }
}

refresh();refreshChat();connectEvents();
setInterval(refresh,4000);
setInterval(()=>{if(!es)refreshChat();},3000);   // fallback only
setInterval(refreshIncident,1500);
</script></body></html>
"""


def main():
    ap = argparse.ArgumentParser(description="Reachy Mini control panel")
    ap.add_argument("--port", type=int, default=7870)
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"Control panel  →  http://{args.host}:{args.port}")
    print(f"  daemon  {DAEMON}   (volume)")
    print(f"  app UI  {APP_UI}   (system prompt — needs 'reachy-app start --ui')")
    print(f"  log     {LOG_FILE}")
    print("Ctrl-C to stop.")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
