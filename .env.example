# Copy to .env and fill in OPENAI_API_KEY. `bin/setup` does this for you.
# .env is gitignored — never commit it.

# --- voice backend ---------------------------------------------------------
# Only conversation app 0.8.x reads these. 0.9.0+ ignore them with a warning and
# silently fall back to Hugging Face, which is why the pin matters.
BACKEND_PROVIDER=openai
MODEL_NAME=gpt-realtime-mini
OPENAI_API_KEY=

# Cost guard. An open session bills for the mic even in silence (~$0.36/hr on
# mini). Upstream default is 1440 minutes (24h), which will quietly drain credit
# overnight.
REACHY_MINI_APP_TIMEOUT_MINUTES=15

# --- robot -> TrueForge ----------------------------------------------------
# Loads tools/ask_agent.py, which lets the robot delegate to a TrueForge agent
# and reach whatever connectors that agent has.
REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=__REPO__/tools
AUTOLOAD_EXTERNAL_TOOLS=true
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_DEFAULT_AGENT=robot-operator

# --- optional --------------------------------------------------------------
# TRUEFORGE_TOKEN=              # OIDC id token; local TrueForge needs none
# TRUEFORGE_TURN_TIMEOUT=45     # how long ask_agent waits before "still working"
# TRUEFORGE_SESSION_TTL_HOURS=12
# TRUEFORGE_SESSION_MAX_TURNS=40
# REACHY_BUSY_MOTION=0          # stop the robot moving while a delegation runs
# REACHY_BUSY_MOVE=waiting      # which emotion to loop; list_moves for all 85
#
# Gemini instead of OpenAI (0.8.x supports it; needs a Google key):
# BACKEND_PROVIDER=gemini
# MODEL_NAME=gemini-3.1-flash-live-preview
# GEMINI_API_KEY=
#
# Free Hugging Face backend (no key needed, higher latency):
# BACKEND_PROVIDER=huggingface
# Directory inside this repository inspected by the one-minute Physical SOC scan.
# Change this when the deliberately vulnerable demo codebase is added.
CVE_TARGET_PATH=demo-fixture

# What the customer calls the scanned repo, in their words. The onboarding
# interview records "payment-service"; the directory is demo-fixture. Without
# this the two never match and the escalation drops the "you flagged this as
# critical" clause.
CVE_TARGET_ALIAS=payment-service
